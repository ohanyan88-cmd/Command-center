{
  "policy_version": "1.1.0",
  "workspace_name": "Command-center",
  "identity": {
    "name": "Deputy",
    "role": "AI Chief of Staff for Sales & Operations",
    "title": "Deputy — AI Chief of Staff for Sales & Operations",
    "workspace": "Command-center",
    "owner": "Gev",
    "owner_native": "Գև",
    "purpose": "Command-center is Gev's operational workspace for Sales & Operations, managed with Deputy — AI Chief of Staff for Sales & Operations.",
    "note": "SINGLE SOURCE OF TRUTH for the agent/workspace identity. engine.identity(), hooks, brief, docs and tests read or mirror this block; nothing else may define a different canonical name. Identity does not change authority: the authority ladder in the skill registry is unaffected."
  },
  "identity_enforcement": {
    "active_files": ["CLAUDE.md", "README.md", ".claude/docs/Role.md", ".claude/docs/Job-description.md", ".claude/hooks/brief.py", ".claude/hooks/gate.py", ".claude/hooks/workspace_guard.py", ".claude/settings.json", ".claude/skills/engine.py", ".claude/skills/skill.py", ".claude/skills/build_registry.py", ".claude/skills/executors.py", ".claude/policy/validate_workspace.py", "00_Inbox/Input.md", "Actions.md"],
    "must_mention": {"CLAUDE.md": ["Deputy", "Command-center"], "README.md": ["Deputy", "Command-center"], ".claude/docs/Role.md": ["Deputy"], ".claude/docs/Job-description.md": ["Deputy"]},
    "stale_patterns": ["Sales-operations-control", "Daily check", "Գործադիր օգնական", "գործադիր օգնական", "Գործառնական օգնական", "AI Executive Assistant", "AI EXECUTIVE ASSISTANT", "AI assistant", "canonical agent = Assistant", "ՕԳՆԱԿԱՆ_", "04_WhatsApp", "01_Ընթացիկ", "02_Արխիվ", "03_Ավարտված", "00_ԳՑԻՐ_ԱՅՍՏԵՂ", "Առաջադրանքներ.xlsx", "ՕՐԱԳԻՐ.md", "ԱՆԵԼԻՔՆԵՐ.md"],
    "historical_line_markers": ["formerly", "historical", "legacy", "previously", "migrated from", "before →", "նախկին", "պատմական", "հին անուն", "was:"],
    "exempt_paths": ["05_Archive", "04_Sources", "03_Completed", "Journal.md", ".claude/docs/Migration-log-2026-09-10.md", ".claude/docs/Registry-audit-2026-09-10.md", ".claude/audit", ".claude/state", ".claude/skills/registry.json", ".claude/skills/certifications", ".claude/tools"],
    "note": "Any active file declaring another canonical workspace/agent name fails validation. Lines carrying a historical marker are exempt (history must stay readable). Archive/Sources/Journal/audit are history and exempt."
  },
  "physical_root_note": "The canonical workspace name is Command-center. If the host prevented a live rename of the open root directory, the remaining step is a manual folder rename with Claude Code closed; nothing inside the workspace depends on the physical parent path.",
  "authority": "This file is the machine-readable structural contract. README.md must agree with it; validate_workspace.py enforces it; workspace_guard.py consumes it.",

  "naming": {
    "business_filename_regex": "^[A-Z][a-z0-9]*(?:-[a-z0-9]+)*(?:-v\\d+(?:\\.\\d+)?)?(?:-\\d{4}-\\d{2}-\\d{2})?\\.[a-z0-9]+$",
    "business_folder_regex": "^[A-Z][a-z0-9]*(?:-[a-z0-9]+)*(?:-v\\d+(?:\\.\\d+)?)?(?:-\\d{4}-\\d{2}-\\d{2})?$",
    "ordered_top_level_regex": "^\\d{2}_[A-Z][a-z]+$",
    "python_module_regex": "^[a-z][a-z0-9_]*\\.py$",
    "technical_filename_regex": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
    "date_regex": "\\d{4}-\\d{2}-\\d{2}",
    "version_regex": "-v\\d+(?:\\.\\d+)?(?=-|\\.)",
    "forbidden_words": ["final", "final2", "new", "newest", "copy", "fixed", "latest", "old", "backup", "temp", "tmp", "draft2", "v1.1-final"],
    "forbidden_patterns": ["\\s", "\\(\\d+\\)", "[()]", "[А-Яа-яԱ-Ֆա-ֆ]", "\\.[A-Z]+$", "__", "\\d{2}\\.\\d{2}\\.\\d{4}", "\\d{4}_\\d{2}_\\d{2}", "-v\\d+\\.\\d+\\.\\d+", "--"],
    "rules": [
      "first alphabetic character uppercase, remaining ordinary letters lowercase",
      "hyphens between words; no spaces; no parentheses; no duplicate suffix like (2)",
      "no final/new/copy/fixed style words",
      "date only YYYY-MM-DD; version only vN or vN.N; version before date; extension lowercase"
    ]
  },

  "reserved_technical_names": {
    "root_files": ["CLAUDE.md", "README.md", ".gitignore", ".gitattributes", "desktop.ini"],
    "root_dirs": [".claude", ".git"],
    "anywhere_files": [".gitkeep"],
    "note": "desktop.ini is a Windows-generated system file; .git/.gitignore/.gitattributes are version-control files."
  },

  "root": {
    "allowed_files": ["CLAUDE.md", "README.md", "Tasks.xlsx", "Journal.md", "Actions.md", ".gitignore", ".gitattributes", "desktop.ini"],
    "required_files": ["CLAUDE.md", "README.md", "Tasks.xlsx", "Journal.md", "Actions.md"],
    "allowed_dirs": ["00_Inbox", "01_Active", "02_Reference", "03_Completed", "04_Sources", "05_Archive", ".claude", ".git"],
    "required_dirs": ["00_Inbox", "01_Active", "02_Reference", "03_Completed", "04_Sources", "05_Archive", ".claude"],
    "unknown_entries": "fail"
  },

  "canonical_files": {
    "Tasks.xlsx":   {"kind": "task-register", "purpose": "The single live task register (hand-edited by the Head; read by skills).", "single_canonical": true, "duplicates_forbidden_globs": ["**/*[Tt]ask*.xlsx", "**/Առաջադրանքներ*.xlsx", "**/ԱՌԱՋԱԴՐԱՆՔՆԵՐ*.xlsx"], "duplicates_allowed_under": ["05_Archive"]},
    "Journal.md":   {"kind": "journal", "purpose": "Daily log, newest day on top.", "single_canonical": true},
    "Actions.md":   {"kind": "internal-todo", "purpose": "Internal document/system to-dos.", "single_canonical": true},
    "CLAUDE.md":    {"kind": "agent-instructions", "purpose": "Behavioral guidance for Deputy (not enforcement)."},
    "README.md":    {"kind": "human-guide", "purpose": "Human-readable guide; must agree with this policy."},
    "00_Inbox/Input.md": {"kind": "text-drop", "purpose": "Controlled manual text drop; processed content is cleared.", "single_canonical": true}
  },

  "directories": {
    "00_Inbox": {"kind": "inbox", "purpose": "Temporary unclassified input only; steady state empty except Input.md.", "canonical": true, "required": true,
                 "allowed_content": ["any file dropped by the Head, pending classification"], "forbidden_content": ["subdirectories", "agent runtime", "processed deliverables"],
                 "allowed_extensions": "*", "naming_rule": "none (transient)", "subdirs": "forbidden", "retention_rule": "must be emptied at every session start; only Input.md persists",
                 "invariants": ["Input.md exists", "no subdirectories", "non-Input files are violations older than one session"]},
    "01_Active": {"kind": "active-work", "purpose": "Work currently being developed, reviewed, investigated or executed.", "canonical": true, "required": true,
                  "subdirs": "fixed", "fixed_subdirs": ["Sales", "Operations", "People", "Systems"], "allowed_content": ["business documents in progress"],
                  "forbidden_content": ["raw WhatsApp exports", "screenshots", "python code", "runtime state", "approved source-of-truth artifacts"],
                  "allowed_extensions": ["docx", "xlsx", "md", "pdf", "pptx", "csv", "txt"], "naming_rule": "business", "retention_rule": "move to 02_Reference when approved and authoritative; to 03_Completed when finished; to 05_Archive when superseded"},
    "02_Reference": {"kind": "reference", "purpose": "Approved CURRENT source-of-truth artifacts still used to operate the business.", "canonical": true, "required": true,
                     "subdirs": "fixed", "fixed_subdirs": ["Sales", "Operations", "People", "Systems"], "allowed_content": ["approved authoritative documents"],
                     "forbidden_content": ["drafts", "raw sources", "python code", "runtime state", "files whose name signals draft/copy"],
                     "allowed_extensions": ["docx", "xlsx", "md", "pdf", "pptx", "csv"], "naming_rule": "business", "retention_rule": "superseded version → 05_Archive the day the replacement is approved"},
    "03_Completed": {"kind": "completed", "purpose": "Finished deliverables no longer active and not the current operational source of truth.", "canonical": true, "required": true,
                     "subdirs": "controlled", "allowed_content": ["finished deliverables"], "forbidden_content": ["raw sources", "python code", "runtime state", "active work"],
                     "allowed_extensions": ["docx", "xlsx", "md", "pdf", "pptx", "csv", "txt"], "naming_rule": "business", "retention_rule": "kept; never edited"},
    "04_Sources": {"kind": "sources", "purpose": "Raw evidence and original external inputs only.", "canonical": true, "required": true,
                   "subdirs": "fixed", "fixed_subdirs": ["Whatsapp", "Screenshots", "Imports"],
                   "allowed_content": ["original exports, chats, media, screenshots, raw imports"], "forbidden_content": ["agent runtime", "python code", "processed deliverables", "job descriptions", "helper code"],
                   "allowed_extensions": ["txt", "md", "zip", "jpg", "jpeg", "png", "pdf", "csv", "xlsx", "json", "opus", "mp3", "mp4", "vcf", "webp"], "naming_rule": "source", "retention_rule": "kept as evidence; never edited",
                   "source_naming": {"folder_regex": "^[A-Z][a-z0-9]*(?:-[a-z0-9]+)*-\\d{4}-\\d{2}-\\d{2}(?:-[a-z0-9]+)*$", "file_rule": "original export names are kept when they already satisfy the technical filename regex; otherwise renamed to business form"}},
    "05_Archive": {"kind": "archive", "purpose": "Superseded documents, obsolete drafts and old implementation artifacts retained for history. Not current truth.", "canonical": true, "required": true,
                   "subdirs": "controlled", "allowed_content": ["anything superseded, kept for history"], "forbidden_content": ["the live task register", "runtime state"],
                   "allowed_extensions": "*", "naming_rule": "business-or-technical", "retention_rule": "never deleted; never edited"},
    ".claude": {"kind": "agent-runtime-root", "purpose": "Deputy runtime: settings, hooks, docs, policy, skills, tools, tests, state, audit.", "canonical": true, "required": true,
                "subdirs": "fixed", "fixed_subdirs": ["hooks", "docs", "policy", "skills", "tools", "tests", "state", "audit"], "allowed_files": ["settings.json", "settings.local.json"], "naming_rule": "technical"},
    ".claude/hooks":  {"kind": "hooks", "purpose": "Lifecycle and enforcement hooks (brief, skill gate, workspace guard).", "required": true, "allowed_extensions": ["py"], "naming_rule": "python_module", "required_files": ["brief.py", "gate.py", "workspace_guard.py"], "subdirs": "forbidden", "generated_ok": ["__pycache__"]},
    ".claude/docs":   {"kind": "docs", "purpose": "Durable agent documentation (role, job description, audits).", "required": true, "allowed_extensions": ["md"], "naming_rule": "business", "required_files": ["Role.md", "Job-description.md"], "subdirs": "forbidden"},
    ".claude/policy": {"kind": "policy", "purpose": "Machine-readable workspace governance + validator.", "required": true, "allowed_extensions": ["json", "py"], "naming_rule": "technical", "required_files": ["workspace_policy.json", "validate_workspace.py"], "subdirs": "forbidden", "generated_ok": ["__pycache__"]},
    ".claude/skills": {"kind": "skill-runtime", "purpose": "Production Skill System only.", "required": true, "allowed_extensions": ["py", "json", "md"], "naming_rule": "technical",
                       "required_files": ["registry.json", "build_registry.py", "engine.py", "executors.py", "skill.py", "certify.py", "store.py"], "allowed_subdirs": ["certifications", "__pycache__"],
                       "forbidden_content": ["test_*.py", "evals.py", "state", "audit", "*.jsonl", "*.db", "raw sources"], "forbidden_globs": ["test_*.py", "evals.py", "*.jsonl", "*.db", "state", "audit"]},
    ".claude/tools":  {"kind": "tools", "purpose": "Operational helper programs that are tools rather than skills.", "required": true, "allowed_extensions": ["py", "md"], "naming_rule": "python_module", "subdirs": "forbidden", "generated_ok": ["__pycache__"]},
    ".claude/tests":  {"kind": "tests", "purpose": "Tests and behavioral evaluations.", "required": true, "allowed_extensions": ["py"], "naming_rule": "python_module", "required_files": ["test_skills.py", "test_hardening.py", "test_workspace.py", "evals.py"], "subdirs": "forbidden", "generated_ok": ["__pycache__"]},
    ".claude/state":  {"kind": "runtime-state", "purpose": "Runtime state only (SQLite store, journal, quarantine, migrated legacy).", "required": true, "allowed_extensions": "*", "naming_rule": "generated", "subdirs": "controlled"},
    ".claude/audit":  {"kind": "audit", "purpose": "Runtime/audit evidence only.", "required": true, "allowed_extensions": ["jsonl"], "naming_rule": "generated", "required_files": ["skill_audit.jsonl"], "subdirs": "forbidden"}
  },

  "generated_exclusions": {
    "ignored_dir_names": ["__pycache__", ".git"],
    "ignored_file_globs": ["*.pyc", "desktop.ini", "Thumbs.db", ".DS_Store", "~$*"],
    "pycache_allowed_under": [".claude/hooks", ".claude/policy", ".claude/skills", ".claude/tools", ".claude/tests"],
    "garbage_globs": ["*.tmp", "*.bak", "*~", "*.orig", "*.swp", "nul", "*.log"]
  },

  "semantics": {
    "source_markers": {"patterns": ["^chat\\.txt$", "^chat\\.md$", "WhatsApp", "\\.zip$", "^Screenshot", "^IMG[-_]", "\\.jpe?g$", "\\.png$"], "must_live_under": "04_Sources", "note": "raw evidence classified by name/kind may only live in 04_Sources (or 05_Archive)"},
    "code_markers": {"patterns": ["\\.py$", "\\.bat$", "\\.ps1$", "\\.sh$", "\\.js$"], "must_live_under": [".claude/hooks", ".claude/policy", ".claude/skills", ".claude/tools", ".claude/tests", "05_Archive"]},
    "runtime_markers": {"patterns": ["\\.db$", "\\.jsonl$", "-wal$", "-shm$"], "must_live_under": [".claude/state", ".claude/audit", "05_Archive"]},
    "test_markers": {"patterns": ["^test_.*\\.py$", "^evals\\.py$"], "must_live_under": [".claude/tests"]},
    "reference_vs_completed": "02_Reference holds artifacts that are still authoritative; 03_Completed holds finished deliverables that are no longer truth. Mechanically checkable part: names signalling draft/copy are forbidden in both; the same base document may not exist in both.",
    "single_canonical_location": ["Tasks.xlsx", "Journal.md", "Actions.md", "00_Inbox/Input.md", ".claude/docs/Role.md", ".claude/docs/Job-description.md", ".claude/skills/registry.json"]
  },

  "links": {"check_markdown_links_in": ["README.md", "CLAUDE.md", "Journal.md", "Actions.md", "00_Inbox/Input.md", ".claude/docs/Role.md", ".claude/docs/Job-description.md"], "note": "relative links must resolve; anchors and URLs are ignored"}
}
