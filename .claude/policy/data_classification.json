{
 "classification_version": "1.1.0",
 "classes": {
  "PUBLIC": {
   "meaning": "May appear anywhere, including a public repository: Deputy's code, policies, schemas, generic role/process vocabulary, customer-facing prices.",
   "versionable": true
  },
  "INTERNAL": {
   "meaning": "Company-internal organizational intelligence without personal or commercial secrets: role definitions, process logic, KPI definitions, routines, playbooks, gap taxonomy, headcount by role, proposal targets. Versionable in the (public) system repository because it identifies no person, no customer and no confidential figure.",
   "versionable": true
  },
  "CONFIDENTIAL": {
   "meaning": "Identifies people, customers or confidential commercial values: employee names and person↔role mappings, salaries/compensation, payroll and cost figures, subscriber/customer records and derived lists, raw WhatsApp exports, screenshots, management decisions with personal content. Local overlay only; never committed.",
   "versionable": false
  },
  "RESTRICTED": {
   "meaning": "Credentials, tokens, keys, system access data, phone numbers/emails/addresses of individuals, billing account identifiers. Never stored in the business model at all; never committed.",
   "versionable": false
  }
 },
 "items": {
  "repository_code": "PUBLIC",
  "workspace_policy_and_schemas": "PUBLIC",
  "role_definitions_without_compensation": "INTERNAL",
  "process_definitions": "INTERNAL",
  "kpi_definitions_and_formulas": "INTERNAL",
  "targets_and_thresholds": "INTERNAL",
  "playbooks_and_routines": "INTERNAL",
  "ownership_by_role": "INTERNAL",
  "source_metadata_ids_paths_authority": "INTERNAL",
  "headcount_by_role": "INTERNAL",
  "customer_facing_tariff_prices": "PUBLIC",
  "employee_names_and_person_role_mappings": "CONFIDENTIAL",
  "salaries_compensation_payroll": "CONFIDENTIAL",
  "cost_investment_margin_figures": "CONFIDENTIAL",
  "customer_subscriber_data_and_derived_lists": "CONFIDENTIAL",
  "raw_whatsapp_exports_and_quotes": "CONFIDENTIAL",
  "screenshots_and_images": "CONFIDENTIAL",
  "management_decisions_with_personal_content": "CONFIDENTIAL",
  "business_documents_docx_xlsx": "CONFIDENTIAL",
  "phone_numbers_emails_addresses_of_individuals": "RESTRICTED",
  "billing_account_and_subscriber_identifiers": "RESTRICTED",
  "credentials_tokens_keys": "RESTRICTED",
  "system_access_data": "RESTRICTED",
  "live_integration_records_calendar_mail_crm_billing": "CONFIDENTIAL",
  "integration_credentials_webhooks_tokens": "RESTRICTED",
  "integration_registry_and_adapters_code": "INTERNAL"
 },
 "path_rules": [
  {
   "pattern": "^\\.claude/integrations/certification\\.json$",
   "class": "INTERNAL",
   "reason": "generated integration certification (states + evidence flags, no payloads, no secrets), local only"
  },
  {
   "pattern": "^\\.claude/integrations/[^/]+\\.json$",
   "class": "CONFIDENTIAL",
   "reason": "any other generated integration file may carry live business records"
  },
  {
   "pattern": "^\\.claude/business/overlay/",
   "class": "CONFIDENTIAL",
   "reason": "sensitive overlay (people, compensation, commercials, evidence)"
  },
  {
   "pattern": "^\\.claude/business/certification\\.json$",
   "class": "INTERNAL",
   "reason": "generated, local"
  },
  {
   "pattern": "^\\.claude/business/[^/]+\\.json$",
   "class": "CONFIDENTIAL",
   "reason": "generated model may embed overlay values at build time"
  },
  {
   "pattern": "^\\.claude/business/Business-model\\.md$",
   "class": "CONFIDENTIAL",
   "reason": "generated view renders overlay values"
  },
  {
   "pattern": "^0[0-5]_[A-Za-z]+/",
   "class": "CONFIDENTIAL",
   "reason": "business documents, sources, archives"
  },
  {
   "pattern": "^(Tasks\\.xlsx|Journal\\.md|Actions\\.md)$",
   "class": "CONFIDENTIAL",
   "reason": "live registers with people and decisions"
  },
  {
   "pattern": "\\.(db|db-wal|db-shm|jsonl|env|pem|key|p12|pfx)$",
   "class": "RESTRICTED",
   "reason": "state stores, secrets material"
  },
  {
   "pattern": "^\\.claude/(state|audit)/",
   "class": "CONFIDENTIAL",
   "reason": "runtime state and audit trail carry prompts and business inputs"
  },
  {
   "pattern": "\\.(xlsx|xlsm|docx|pdf|jpe?g|png|zip)$",
   "class": "CONFIDENTIAL",
   "reason": "business documents, exports, screenshots"
  },
  {
   "pattern": "^\\.venv/",
   "class": "PUBLIC",
   "reason": "generated runtime, never versioned (size, not secrecy)"
  },
  {
   "pattern": "^\\.claude/settings\\.local\\.json$",
   "class": "RESTRICTED",
   "reason": "local machine settings may carry tokens"
  }
 ],
 "content_rules": [
  {
   "id": "secret_github_token",
   "class": "RESTRICTED",
   "pattern": "\\b(gho|ghp|ghs|ghu|github_pat)_[A-Za-z0-9_]{20,}"
  },
  {
   "id": "secret_aws",
   "class": "RESTRICTED",
   "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
  },
  {
   "id": "secret_private_key",
   "class": "RESTRICTED",
   "pattern": "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
  },
  {
   "id": "secret_assignment",
   "class": "RESTRICTED",
   "pattern": "(?i)\\b(password|passwd|api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token)\\s*[:=]\\s*['\"]?[A-Za-z0-9_\\-./+]{8,}"
  },
  {
   "id": "secret_slack_or_bearer",
   "class": "RESTRICTED",
   "pattern": "\\b(xox[abp]-[A-Za-z0-9-]{10,}|Bearer [A-Za-z0-9._\\-]{20,})"
  },
  {
   "id": "phone_am_mobile",
   "class": "RESTRICTED",
   "pattern": "(?<![\\w.])(\\+374|0)(33|41|43|44|49|55|77|91|93|94|95|96|97|98|99)[ -]?\\d{2}[ -]?\\d{2}[ -]?\\d{2}(?![\\w.])"
  },
  {
   "id": "email_personal",
   "class": "RESTRICTED",
   "pattern": "\\b[A-Za-z0-9._%+-]+@(gmail|yahoo|mail|yandex|outlook|hotmail|icloud)\\.[a-z]{2,}\\b"
  },
  {
   "id": "subscriber_login_id",
   "class": "RESTRICTED",
   "pattern": "\\bUser_\\d{5,}\\b"
  },
  {
   "id": "salary_field",
   "class": "CONFIDENTIAL",
   "pattern": "(?i)(\\b(fix_salary\\w*|salary_net\\w*|net_salary\\w*|gross_salary\\w*)\\b[\\\"']?\\s*[:=]\\s*[\\[{\\\"']?\\s*\\d|\\bfix_salary\\w*\\s*=\\s*\\{|աշխատավարձ[ա-ֆ]*\\s*[:=]\\s*\\d)"
  },
  {
   "id": "payroll_field",
   "class": "CONFIDENTIAL",
   "pattern": "(?i)\\b(payroll_amd|monthly_fixed_payroll_amd|bonus_fund_amd)\\b\\s*[:=]"
  },
  {
   "id": "subscriber_row",
   "class": "CONFIDENTIAL",
   "pattern": "(?i)\\b(Rank\\s*\\|\\s*Score\\s*\\|\\s*Band|Monthly fee \\(AMD\\)|Balance \\(AMD\\))"
  },
  {
   "id": "whatsapp_export_header",
   "class": "CONFIDENTIAL",
   "pattern": "WhatsApp Chat Export:|\\[\\d{1,2}:\\d{2} (AM|PM)\\] \\*\\*"
  },
  {
   "id": "overlay_marker",
   "class": "CONFIDENTIAL",
   "pattern": "\"layer\"\\s*:\\s*\"SENSITIVE_OVERLAY\"|OVERLAY_DATA\\s*="
  }
 ],
 "allow_rules": [
  {
   "id": "policy_self",
   "paths": [
    "^\\.claude/policy/data_classification\\.json$",
    "^\\.claude/policy/sensitive_scan\\.py$",
    "^\\.claude/tests/test_boundary\\.py$"
   ],
   "reason": "the classification/scanner/tests contain the patterns themselves (fixtures are synthetic)"
  },
  {
   "id": "owner_identity",
   "literals": [
    "Gev",
    "Գև",
    "Gev Ohanyan"
   ],
   "reason": "workspace owner identity is public (policy identity, git author)"
  },
  {
   "id": "role_titles",
   "literals": [
    "Վաճառքի ղեկավար",
    "Բիլինգի և եկամտի ղեկավար"
   ],
   "reason": "roles are INTERNAL vocabulary, not persons"
  }
 ],
 "versionable_classes": [
  "PUBLIC",
  "INTERNAL"
 ],
 "note": "The scanner (sensitive_scan.py) blocks any staged/pushed file whose path or content resolves to CONFIDENTIAL or RESTRICTED; person names come from the local overlay (never listed here). Private Git is not a secrets database: this boundary applies regardless of repository visibility."
}
